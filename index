    <a class="card" href="https://kick.com/cavernaquest" target="_blank" rel="noopener noreferrer">
      <span class="icon-box"><svg viewBox="0 0 24 24"><path d="M3 3h4.5v5.2L12 3h5.6l-6 6.9L18 21h-5.7l-4.3-6.4L7.5 17V21H3V3Z"/></svg></span>
      <span class="card-text"><span class="card-plat">KICK</span><span class="card-handle">@cavernaquest</span></span>

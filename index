    <a class="card" href="https://www.youtube.com/@Cavernaquest" target="_blank" rel="noopener noreferrer">
      <span class="icon-box"><svg viewBox="0 0 24 24"><path d="M21.6 7.6a3 3 0 0 0-2.1-2.1C17.7 5 12 5 12 5s-5.7 0-7.5.5a3 3 0 0 0-2.1 2.1A31 31 0 0 0 2 12a31 31 0 0 0 .4 4.4 3 3 0 0 0 2.1 2.1C6.3 19 12 19 12 19s5.7 0 7.5-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 22 12a31 31 0 0 0-.4-4.4ZM10 15.5v-7l6 3.5-6 3.5Z"/></svg></span>

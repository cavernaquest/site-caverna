      <span class="card-arrow" aria-hidden="true">↗</span>
    </a>

    <a class="card" href="https://www.instagram.com/cavernaquest" target="_blank" rel="noopener noreferrer">
      <span class="icon-box"><svg viewBox="0 0 24 24"><path d="M8 2h8a6 6 0 0 1 6 6v8a6 6 0 0 1-6 6H8a6 6 0 0 1-6-6V8a6 6 0 0 1 6-6Zm0 2a4 4 0 0 0-4 4v8a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4V8a4 4 0 0 0-4-4H8Zm4 3.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5Zm0 2A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5ZM17.4 6a1 1 0 1 1-1 1 1 1 0 0 1 1-1Z"/></svg></span>
      <span class="card-text"><span class="card-plat">INSTAGRAM</span><span class="card-handle">@CavernaQuest</span></span>
      <span class="card-arrow" aria-hidden="true">↗</span>
    </a>

    <a class="card shop-card" href="https://streamersclub.com.br/streamers/cavernaquest" target="_blank" rel="noopener noreferrer">
      <span class="icon-box"><svg viewBox="0 0 24 24"><path d="M6 2 4 6v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6l-2-4H6Zm1.2 2h9.6l1 2H6.2l1-2ZM6 8h12v12H6V8Zm3 2v2a3 3 0 0 0 6 0v-2h-2v2a1 1 0 0 1-2 0v-2H9Z"/></svg></span>
      <span class="card-text"><span class="card-plat">COMPRE NA NOSSA LOJINHA</span><span class="card-handle">CavernaQuest no Streamers Club</span></span>
      <span class="card-arrow" aria-hidden="true">↗</span>
    </a>

  </main>

  <footer>
    <div class="divider"></div>
    <p class="brand-line">CAVERNA QUEST © 2026</p>
    <p>Jogos e outras obsessões.</p>
  </footer>

</div>
</body>
</html>
